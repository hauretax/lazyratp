<?xml version="1.0" encoding="utf-8"?>
<!--
  Rien ne sort de l'appareil. La cle API PRIM vit en DataStore : elle n'a a
  partir ni dans une sauvegarde cloud, ni dans un transfert vers un autre
  telephone. android:allowBackup="false" ne couvre plus Android 12 et au-dela.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
